<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.fts">

    <!-- Broad filesystem access. On Android 11+ this is a special "All files access" permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FtsApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_folder"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_folder"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".ui.main.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.tree.TreeActivity" android:exported="false" />
        <activity android:name=".ui.diff.DiffActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.cache.CacheManageActivity" android:exported="false" />

        <service
            android:name=".service.ScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
